{
  "name": "arclet",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' --parallel dev",
    "dev:web": "bun --filter @arclet/web dev",
    "dev:worker": "bun apps/worker/src/index.ts",
    "build": "bun run typecheck && bun --filter @arclet/web build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:seed": "bun scripts/seed-config.ts",
    "doctor": "bun scripts/doctor.ts",
    "probe:arc": "bun scripts/probe-arc.ts",
    "probe:graph": "bun scripts/probe-graph.ts",
    "probe:circle": "bun scripts/probe-circle.ts",
    "provision:wallets": "bun scripts/provision-wallets.ts",
    "verify:live": "bun scripts/verify-live-flow.ts",
    "evidence:export": "bun scripts/export-evidence.ts",
    "check:readiness": "bun scripts/check-readiness.ts",
    "check:mainnet": "bun scripts/check-mainnet-readiness.ts",
    "docs:diagram": "mmdc -i docs/architecture.mmd -o docs/architecture.svg -b transparent"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.54",
    "@privy-io/react-auth": "3.42.0",
    "@privy-io/server-auth": "1.32.5",
    "ai": "5.0.257",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.44.7",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
