{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@arclet/domain": ["packages/domain/src/index.ts"],
      "@arclet/policy": ["packages/policy/src/index.ts"],
      "@arclet/graph": ["packages/graph/src/index.ts"],
      "@arclet/circle": ["packages/circle/src/index.ts"],
      "@arclet/chain": ["packages/chain/src/index.ts"],
      "@arclet/agent": ["packages/agent/src/index.ts"],
      "@arclet/db": ["packages/db/src/index.ts"]
    }
  }
}
