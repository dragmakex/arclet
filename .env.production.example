# Native nginx/systemd deployment. Copy to .env.production and chmod 600.
APP_ENV=arc-testnet
APP_CANONICAL_ORIGIN=http://127.0.0.1:3100
# Replaced with a generated local-only password by ops/install-host.sh.
DATABASE_URL=postgresql:///arclet?host=/var/run/postgresql
NEXT_PUBLIC_APP_ENV=arc-testnet
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_PROBE_ACCOUNT=
ARC_PROBE_TX_HASH=
SOURCE_RPC_URL=
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
GRAPH_DEPLOYMENT_ID=
GRAPH_POOL_ID=
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
CIRCLE_CLI_PATH=
CIRCLE_HOME=/home/sticky/.arclet-circle
CIRCLE_CHAIN=ARC-TESTNET
MAX_FUNDED_USERS=5
MAX_TRADE_USDC_ATOMIC=2000000
MAX_DAILY_TURNOVER_USDC_ATOMIC=5000000
MIN_USDC_RESERVE_ATOMIC=2000000
MAX_SLIPPAGE_BPS=100
TRADING_ENABLED=false
ALLOW_MAINNET=false
EVIDENCE_DIR=./docs/evidence
