# Netcup Ubuntu deployment. Copy to .env.production and chmod 600.
ARCLET_DOMAIN=arclet.example.com
ACME_EMAIL=admin@example.com
# URL-safe hexadecimal only. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-lowercase-hex-characters

APP_ENV=arc-testnet
APP_CANONICAL_ORIGIN=https://arclet.example.com
NEXT_PUBLIC_APP_ENV=arc-testnet
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
DEMO_USER_ALLOWLIST=

ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_PROBE_ACCOUNT=
ARC_PROBE_TX_HASH=
SOURCE_RPC_URL=
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
GRAPH_DEPLOYMENT_ID=
GRAPH_POOL_ID=

AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# These are overridden inside the production worker container.
CIRCLE_CLI_PATH=/usr/local/bin/circle
CIRCLE_HOME=/home/bun
CIRCLE_CHAIN=ARC-TESTNET

MAX_FUNDED_USERS=5
MAX_TRADE_USDC_ATOMIC=2000000
MAX_DAILY_TURNOVER_USDC_ATOMIC=5000000
MIN_USDC_RESERVE_ATOMIC=2000000
MAX_SLIPPAGE_BPS=100
TRADING_ENABLED=false
ALLOW_MAINNET=false
EVIDENCE_DIR=./docs/evidence
